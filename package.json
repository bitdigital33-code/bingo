{
  "name": "bingo-familiar-premium",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm-run-all build:contracts build:api build:web",
    "build:contracts": "npm run build -w packages/contracts",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "lint": "npm-run-all lint:api lint:web",
    "lint:api": "npm run lint -w apps/api",
    "lint:web": "npm run lint -w apps/web",
    "test": "npm-run-all test:api test:web",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "format": "prettier --write .",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:push": "npm run prisma:push -w apps/api",
    "prisma:seed": "npm run prisma:seed -w apps/api"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
